# =========================================================
# Data files
# =========================================================

# Keep huge raw datasets out of Git.
data/raw/
data/imports/
data/exports/

# Allow small samples for portfolio/demo purposes.
!data/samples/
!data/samples/.gitkeep

# Common large data formats
*.csv
*.tsv
*.jsonl
*.ndjson

# Allow explicit sample files:
!data/samples/*.csv
!data/samples/*.json

